# Copy to .env for local development.
APP_ENV=development
DATABASE_URL=sqlite:///./stockflow.db
# Replace with a unique random 32+ character secret outside local development.
SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
TOKEN_TTL_HOURS=12
# Comma-separated origins only when hosting the frontend on a different origin.
CORS_ORIGINS=

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stockflow
# MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/stockflow?charset=utf8mb4
